# Habilitar mod_rewrite
RewriteEngine On

# Forçar www + https (exceto ambiente local)
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\. [NC]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Unificar landing pages na URL canônica
RewriteRule ^criar-landing-page/?$ /desenvolvimento-de-landing-page [R=301,L]
RewriteRule ^criar-landing-pages/?$ /desenvolvimento-de-landing-page [R=301,L]
RewriteRule ^criacao-de-landing-pages/?$ /desenvolvimento-de-landing-page [R=301,L]

# Meus assets: nunca cachear (evita mistura de versões durante deploy)
<FilesMatch "^(qv|qv-icons)\.css$|^qv\.js$">
    Header set Cache-Control "no-store, must-revalidate"
</FilesMatch>

# PHP com mesmo nome de diretório vence o diretório (ex.: /portfolio-new -> portfolio-new.php)
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]

# Não processar se o alvo já for arquivo ou diretório real
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Redirecionar apenas REQUISIÇÕES GET de *.php -> sem extensão
# (evita quebrar formulários POST)
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php(?:[\s?]) [NC]
RewriteRule ^ %1 [R=301,L]

# Reescrever URL sem extensão para .php se o arquivo existir
# (regrava internamente, sem redirecionar)
RewriteCond %{REQUEST_URI} !\.php$ [NC]
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]
